[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = DALConfigLib
  FILE_GUID                      = 9ddf0f91-94d3-41c5-9c3a-3634c98e8231
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = DALConfigLib
  MACRO_NAME                     = core

[Defines.AARCH64]
