[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ChipInfoLoaderLib
  FILE_GUID                      = DA3DB2B5-785B-4B94-AEA4-14EF557973A5
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = ChipInfoLoaderLib

[BuildOptions.AARCH64]
  GCC:*_*_*_CC_FLAGS = -Werror 

[Sources]
  ChipInfoLoader.c
  ChipInfo.c
  DalChipInfoFwk.c
  ChipInfoBSP.c
  ChipInfoImage.c

[Packages]
  MdePkg/MdePkg.dec
  QcomPkg/QcomPkg.dec
  QcomPkg/XBLLoaderApi.dec

[LibraryClasses]
  BaseLib
  MuslLib
  ChipInfoTargetLib
