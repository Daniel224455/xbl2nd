[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = MDPPlatformLib
  FILE_GUID                      = FE680889-1B2B-4D0C-81DD-43D76A384B92
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = MDPPlatformLib

[Sources.common]
