[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = MeasureBootDxe
  FILE_GUID                      = 252CCE76-28E9-4B57-B91F-57770847B47B
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = MeasureBootDxeInitialize

[Sources]
  MeasureBootDxe.c

[Packages]
  ArmPkg/ArmPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  QcomPkg/QcomPkg.dec

[UserExtensions.PackIt.PackOut.LZB]
  ../MeasureBootDxe
  
[UserExtensions.PackIt.PackOut.AUZB]
  ../MeasureBootDxe

[LibraryClasses]
  UefiLib
  PeHashLib  
  QcomLib
  SecBootBaseLib
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  BootConfigLib

[Guids]
  gEfiSalSystemTableGuid
  gEfiSmbiosTableGuid
  gEfiAcpiTableGuid
  gEfiImageSecurityDatabaseGuid
  gEfiGlobalVariableGuid
  gEfiEmmcUserPartitionGuid 
  gEfiUfsLU4Guid
  gEfiNvme0Guid

[Protocols]
  gEfiTrEEProtocolGuid
  gQcomAcpiPlatformProtocolGuid
  gQcomMeasureBootProtocolGuid               ## PRODUCES
  gEfiSMEMProtocolGuid

[Depex]
  TRUE
