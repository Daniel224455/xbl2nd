[BuildOptions.AARCH64]
  GCC:*_*_*_DLINK_FLAGS = --whole-archive $(WORKSPACE)/Build/$(TARGETMSM)_Loader/$(TARGET)_$(TOOLCHAIN)/$(ARCH)/$(TARGETROOT)/Library/PmicLib/loader/AU/Pmic/OUTPUT/Pmic.lib --no-whole-archive


