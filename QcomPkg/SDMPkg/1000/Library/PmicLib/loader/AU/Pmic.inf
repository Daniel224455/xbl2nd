[Defines]
  INF_VERSION       = 0x00010005
  BASE_NAME         = Pmic
  FILE_GUID         = 1D5B8D44-45CB-C0A3-777C-3BB37755B9E6
  MODULE_TYPE       = USER_DEFINED
  VERSION_STRING    = 1.0

 
[Sources.common]
   ../../../../../../Library/PmicLib/target/sa8195_pmm8195au/psi/pm_config_target_sbl_sequence.c
   ../../../../../../Library/PmicLib/target/sa8195_pmm8195au/psi/pm_config_target_pbs_ram.c
   ../../../../../../Library/PmicLib/target/sa8195_pmm8195au/psi/pm_config_target_sdam.c
