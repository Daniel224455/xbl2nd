[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ButtonsLib
  FILE_GUID                      = 868A65D7-6EDD-4324-87F7-C68B88D1DBF4
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = ButtonsLib

[Sources.common]
  ButtonsLib.c

[BuildOptions]

[Packages]
  MdePkg/MdePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  QcomPkg/QcomPkg.dec
  QcomPkg/SDM845Pkg/SDM845Pkg.dec
  ArmPkg/ArmPkg.dec

[LibraryClasses]
  BaseMemoryLib
  PcdLib
  UefiLib
  UefiDriverEntryPoint
  MemoryAllocationLib
  UefiCfgLib
  OfflineCrashDumpLib

[Protocols]
  gEfiPlatformInfoProtocolGuid
  gQcomPmicGpioProtocolGuid
  gQcomPmicPwrOnProtocolGuid

[Pcd]

[Depex]
  gEfiPlatformInfoProtocolGuid
  AND gQcomPmicGpioProtocolGuid
  AND gQcomPmicPwrOnProtocolGuid
