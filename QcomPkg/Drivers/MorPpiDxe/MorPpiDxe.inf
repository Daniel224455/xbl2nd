[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = MorPpiDxe
  FILE_GUID                      = FA23756A-E014-4C45-85B3-A082627BFA83
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = MorPpiDxeInitialize

[Sources.common]
  MorPpiDxe.c

[Sources.AARCH64]
  MorPpiMemClear.S     | GCC

[Packages]
  ArmPkg/ArmPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  QcomPkg/QcomPkg.dec

[UserExtensions.PackIt.PackOut.LZB]
  ../MorPpiDxe

[UserExtensions.PackIt.PackOut.AUZB]
  ../MorPpiDxe

[LibraryClasses]
  UefiLib
  DebugLib
  QcomLib
  UefiDriverEntryPoint
  UefiBootServicesTableLib

[Guids]
  gEfiMemoryOverwriteControlDataGuid    ## CONSUMES
  gQcomTokenSpaceGuid                   ## CONSUMES

[Protocols]
  gQcomMorPpiProtocolGuid               ## PRODUCES
  gEfiTpmProtocolGuid                   ## CONSUMES

[Depex]
  TRUE
  
